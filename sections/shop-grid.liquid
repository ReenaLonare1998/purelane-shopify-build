{% comment %}
  Purelane — Shop / product grid section. Source: purelane-homepage.html `#shop`.

  Sourced entirely from a real Shopify collection rather than individual
  hand-picked products, so "how many products show" and "which products
  show" are both ordinary merchant actions (pick a collection, reorder it
  in the collection's own sort settings) instead of a per-product setting
  list here. See BUILD_NOTES.md for what changed from the prototype and why.
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'section-shop-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section class="pl-sec" id="shop">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="pl-d2">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        {% render 'purelane-icon', icon: 'leaf' %}
        <i></i>
      </div>
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="pl-shelf">
        {%- for product in collection.products limit: limit -%}
          {%- assign delay = forloop.index0 | modulo: 4 -%}
          {%- render 'purelane-card-product', product: product, reveal_delay: delay -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="pl-glass pl-sec-pad pl-shop__empty">
        <p class="pl-body-s">
          {%- if section.settings.collection == blank -%}
            Select a collection in the theme editor to show products here.
          {%- else -%}
            This collection doesn't have any products yet.
          {%- endif -%}
        </p>
      </div>
    {%- endif -%}
  </div>
</section>

{{ 'purelane-reveal.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "pl-shop-grid-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 }
  ],
  "presets": [
    {
      "name": "Shop grid",
      "settings": {
        "kicker": "Bestsellers",
        "heading": "Loved by 30,000 homes",
        "products_to_show": 8
      }
    }
  ]
}
{% endschema %}
