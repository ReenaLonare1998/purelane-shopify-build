{% comment %}
  Purelane — Reviews rail section. Source: purelane-homepage.html `#reviews`.

  Each card is a "review" block referencing a `review` metaobject (see
  METAFIELDS.md). The prototype hand-duplicated its 6 review cards once
  in raw HTML (12 <article>s total) to fake a seamless marquee loop —
  that only worked because the count was fixed. Here the block list is
  rendered twice by the section (not authored twice by hand), so the
  loop stays seamless no matter how many review blocks a merchant adds,
  removes, or reorders. The second pass is aria-hidden so screen readers
  don't hear every review twice.
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-scene.css' | asset_url | stylesheet_tag }}
{{ 'section-reviews-rail.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
-%}

<section class="pl-revband" id="reviews">
  {% render 'purelane-scene-bg' %}
  <div class="pl-wrap pl-revband__inner">
    <div class="pl-revhead pl-rv">
      {%- if section.settings.kicker != blank -%}
        <h2 class="pl-kicker">{{ section.settings.kicker }}</h2>
      {%- endif -%}
      {%- if section.settings.rating_value != blank -%}
        <span class="pl-revhead__agg">
          <span class="pl-revhead__stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span class="visually-hidden">Rated {{ section.settings.rating_value }} out of 5</span>
          <b>{{ section.settings.rating_value }}</b> {{ section.settings.rating_count_label }}
        </span>
      {%- endif -%}
      {%- if section.settings.loved_by_value != blank -%}
        <span class="pl-revhead__agg">Loved by <b>{{ section.settings.loved_by_value }}</b> homes</span>
      {%- endif -%}
    </div>

    {%- if review_blocks.size > 0 -%}
      <div class="pl-revrail pl-rv" aria-label="Customer reviews">
        <div class="pl-revtrack">
          {%- for block in review_blocks -%}
            {%- if block.settings.review != blank -%}
              {%- render 'purelane-card-review', review: block.settings.review, block_attributes: block.shopify_attributes -%}
            {%- endif -%}
          {%- endfor -%}
          {%- for block in review_blocks -%}
            {%- if block.settings.review != blank -%}
              {%- render 'purelane-card-review', review: block.settings.review, aria_hidden: true -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="pl-glass pl-sec-pad pl-reviews__empty">
        <p class="pl-body-s">Add a review block and select a review to show it here.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{{ 'purelane-reveal.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Reviews rail",
  "tag": "section",
  "class": "pl-reviews-rail-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Heading", "default": "That's what they said" },
    { "type": "text", "id": "rating_value", "label": "Aggregate rating", "default": "4.8" },
    { "type": "text", "id": "rating_count_label", "label": "Rating count label", "default": "from 8,000+ reviews" },
    { "type": "text", "id": "loved_by_value", "label": "\"Loved by\" value", "default": "12 lakh+" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "metaobject", "id": "review", "metaobject_type": "review", "label": "Review" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews rail",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
