{% comment %}
  Purelane — Best-selling combos section. Source: purelane-homepage.html `#combos`.

  Each card is a "combo" metaobject reference block (see METAFIELDS.md) —
  merchants add/remove/reorder combos as blocks, but the actual combo
  data (title, tray items, price) lives in one reusable metaobject entry
  rather than being retyped per-section if a combo is ever featured
  elsewhere too.
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'section-combos.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign combo_blocks = section.blocks | where: 'type', 'combo'
-%}

<section class="pl-sec" id="combos">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="pl-d2">{{ section.settings.heading }}</h2>
      <div class="pl-rule">
        <i></i>
        {% render 'purelane-icon', icon: 'leaf' %}
        <i></i>
      </div>
      {%- if section.settings.lede != blank -%}
        <p class="pl-lede">{{ section.settings.lede }}</p>
      {%- endif -%}
    </div>

    {%- if combo_blocks.size > 0 -%}
      <div class="pl-comborail pl-rv">
        {%- for block in combo_blocks -%}
          {%- if block.settings.combo != blank -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'purelane-card-combo', combo: block.settings.combo -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.swipecue_text != blank -%}
        <div class="pl-swipecue" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          {{ section.settings.swipecue_text }}
        </div>
      {%- endif -%}
      {%- if section.settings.rail_note != blank -%}
        <p class="pl-railnote">{{ section.settings.rail_note }}</p>
      {%- endif -%}
    {%- else -%}
      <div class="pl-glass pl-sec-pad pl-combos__empty">
        <p class="pl-body-s">Add a combo block and select a combo to show it here.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{{ 'purelane-reveal.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Best-selling combos",
  "tag": "section",
  "class": "pl-combos-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "lede", "label": "Supporting text", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "text", "id": "swipecue_text", "label": "Swipe cue text", "default": "Swipe for more combos" },
    { "type": "text", "id": "rail_note", "label": "Rail footnote", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "metaobject", "id": "combo", "metaobject_type": "combo", "label": "Combo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best-selling combos",
      "blocks": [
        { "type": "combo" },
        { "type": "combo" },
        { "type": "combo" }
      ]
    }
  ]
}
{% endschema %}
